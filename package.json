{
  "name": "test-crud-project-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "env:apply": "node scripts/apply-angular-env.cjs",
    "prestart": "node scripts/apply-angular-env.cjs",
    "start": "ng serve",
    "serve": "npm start",
    "start:iat": "node scripts/apply-angular-env.cjs iat && ng serve",
    "start:dev": "node scripts/apply-angular-env.cjs dev && ng serve",
    "start:stg": "node scripts/apply-angular-env.cjs stg && ng serve",
    "postinstall": "node scripts/apply-angular-env.cjs",
    "build": "node scripts/apply-angular-env.cjs && ng build",
    "build:dev": "node scripts/apply-angular-env.cjs && ng build --configuration development",
    "build:stg": "node scripts/apply-angular-env.cjs stg && ng build --configuration staging",
    "build:prod": "node scripts/apply-angular-env.cjs prod && ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/apply-angular-env.cjs",
    "test": "ng test",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,html,scss,css}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.json": [
      "prettier --write"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@fullcalendar/angular": "^6.1.20",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/multimonth": "^6.1.20",
    "@fullcalendar/rrule": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@ng-icons/core": "^33.2.2",
    "@ng-icons/lucide": "^33.2.2",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@spartan-ng/brain": "^0.0.1-alpha.676",
    "autoprefixer": "^10.5.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "ng2-charts": "^10.0.0",
    "postcss": "^8.5.10",
    "rrule": "^2.8.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tslib": "^2.3.0",
    "uuid": "^14.0.0",
    "zod": "^3.24.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@spartan-ng/cli": "^0.0.1-alpha.678",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/jasmine": "~5.1.0",
    "@types/uuid": "^10.0.0",
    "angular-eslint": "21.3.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9",
    "typescript-eslint": "8.56.1"
  },
  "overrides": {
    "@spartan-ng/cli": {
      "ajv": "^8.18.0",
      "picomatch": "^4.0.4",
      "brace-expansion": "^5.0.5"
    },
    "nx": {
      "brace-expansion": "^5.0.5",
      "follow-redirects": "^1.15.12",
      "yaml": "^2.8.3"
    },
    "uuid": "^14.0.0",
    "@angular-devkit/build-angular": {
      "postcss": "^8.5.10"
    }
  }
}
